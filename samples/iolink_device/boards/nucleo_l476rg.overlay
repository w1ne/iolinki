 *
 * Binds the iolinki UART PHY to USART1 on the nucleo_l476rg. USART1 is exposed
 * on the Arduino/Morpho headers, leaving USART2 free for the console/log.
 */

/ {
    chosen {
        zephyr,iolink-uart = &usart1;
    };
};

&usart1 {
    status = "okay";
    current-speed = <38400>;
};
